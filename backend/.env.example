# Backend Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DEBUG=false

# Database
DATABASE_URL=mongodb://localhost:27017/ai-platform
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# API
API_VERSION=v1
API_PREFIX=/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Job Queue
JOB_QUEUE_NAME=ai-tasks
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000
JOB_TIMEOUT=300000

# Storage
STORAGE_TYPE=local
STORAGE_PATH=/tmp/ai-platform-storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-platform
S3_REGION=us-east-1

# Agnes AI Provider
AGNES_ENABLED=true
AGNES_API_KEY=change-me-in-production
AGNES_API_URL=https://api.agnes.ai
AGNES_TIMEOUT=300000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
