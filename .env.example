# Platform Configuration
NODE_ENV=development
PLATFORM_NAME="AI Creation Platform"
PLATFORM_VERSION=1.0.0

# Server Configuration
PORT=3000
HOST=0.0.0.0
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
MOBILE_URL=http://localhost:8081

# Database
DATABASE_URL=mongodb://mongodb:27017/ai-platform
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Storage
STORAGE_TYPE=s3  # s3, local, gcs
STORAGE_PATH=/data/storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-platform
S3_REGION=us-east-1

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Job Queue
JOB_QUEUE_NAME=ai-tasks
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000

# Agnes AI Provider
AGNES_ENABLED=true
AGNES_API_KEY=your-agnes-api-key
AGNES_API_URL=https://api.agnes.ai
AGNES_MODEL_IMAGE=agnes-image-v1
AGNES_MODEL_VIDEO=agnes-video-v1
AGNES_MODEL_AUDIO=agnes-audio-v1
AGNES_MODEL_TTS=agnes-tts-v1
AGNES_TIMEOUT=300000

# OpenAI Provider (future)
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Stability AI Provider (future)
STABILITY_ENABLED=false
STABILITY_API_KEY=
STABILITY_ENGINE_ID=stable-diffusion-xl-1024-v1-0

# Sandbox
SANDBOX_ENABLED=true
SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_IMAGE=sandbox:latest
SANDBOX_TIMEOUT=300000
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2

# Monitoring
MONITORING_ENABLED=false
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Debug
DEBUG=false
DEBUG_PROVIDERS=false
DEBUG_ROUTING=false
